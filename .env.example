# ── Required ──────────────────────────────────────────────
JWT_SECRET=generate-a-random-secret-min-32-chars
CREDENTIAL_ENCRYPTION_KEY=generate-a-fernet-key

# ── Database ──────────────────────────────────────────────
# Omit to use default SQLite at ~/.whitematter/whitematter.db
# DATABASE_URL=postgresql://whitematter:changeme@db:5432/whitematter
# POSTGRES_PASSWORD=changeme
# POSTGRES_USER=whitematter
# POSTGRES_DB=whitematter
# WHITEMATTER_DATA_DIR=~/.whitematter

# ── URLs ──────────────────────────────────────────────────
# PLATFORM_URL=http://localhost:8080
# PLATFORM_PUBLIC_URL=http://localhost:8080
# FRONTEND_URL=http://localhost:3000
# ALLOWED_ORIGINS=http://localhost:3000

# ── AI / LLM ─────────────────────────────────────────────
# ANTHROPIC_API_KEY=sk-ant-...

# ── Stripe Billing (optional) ────────────────────────────
# STRIPE_SECRET_KEY=sk_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRO_PRICE_ID=price_...
# STRIPE_SCALE_PRICE_ID=price_...

# ── AWS GPU Provisioning (optional) ──────────────────────
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1
# GPU_INSTANCE_TYPE=g4dn.xlarge
# GPU_AMI=ami-0a0c8eebcdd6dcbd0

# ── R2 / S3 Storage (optional) ───────────────────────────
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_ENDPOINT=https://...r2.cloudflarestorage.com
# R2_BUCKET=whitematter

# ── Google OAuth (optional) ───────────────────────────────
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# ── Server ────────────────────────────────────────────────
# WORKERS=4
